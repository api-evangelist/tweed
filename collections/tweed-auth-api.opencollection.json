{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tweed assets auth API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AuthController_verify",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/auth"
          }
        },
        {
          "info": {
            "name": "AuthController_getApiKeys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/auth/api-keys"
          }
        },
        {
          "info": {
            "name": "AuthController_generateApiToken",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/auth/api-keys"
          }
        },
        {
          "info": {
            "name": "AuthController_deleteApiKey",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/auth/api-keys/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}